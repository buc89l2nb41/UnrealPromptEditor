{
  "version": 1,
  "vocabulary": {
    "form": {
      "many_instances": "Many separate particles spread through space",
      "camera_card": "One card that always faces the camera, usually with animated frames",
      "warp_card": "One texture whose pixels warp or flow with noise",
      "continuous_strip": "A connected trail, beam, or ribbon",
      "chunks_3d": "Visible 3D pieces with volume",
      "flat_surface": "A flat layer that lies on or parallel to the ground",
      "field_2d": "A 2D grid field or fluid simulation",
      "grid_pattern": "Particles arranged on a regular grid",
      "audio_reactive": "Shape driven by an audio signal"
    },
    "emission": {
      "burst": "Spawns once or in pulses",
      "continuous": "Spawns every frame",
      "static": "No spawning; a single surface or card"
    },
    "motion": {
      "rising": "Moves upward",
      "falling": "Drops under gravity",
      "drifting": "Floats slowly with noise",
      "radial": "Moves outward from a center",
      "directional": "Moves along one direction or cone",
      "following": "Trails behind a moving source",
      "static": "Stays in place",
      "flowing": "Surface pattern moves but the shape stays"
    },
    "orientation": {
      "camera_facing": "Sprites turn toward the camera; actor rotation does not change them",
      "velocity_aligned": "Sprites stretch along their velocity",
      "flat_horizontal": "Lies flat; needs a mesh plane or custom sprite facing",
      "strip": "Ribbon follows its spawn path",
      "mesh": "Real 3D mesh orientation"
    }
  },
  "templates": [
    {
