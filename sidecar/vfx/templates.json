  "param_adjustments": [
    {"keywords": ["밝게", "brighter"], "change": "increase Intensity, Alpha, Emissive"},
    {"keywords": ["어둡게", "darker"], "change": "decrease Intensity, Alpha"},
    {"keywords": ["빠르게", "faster"], "change": "increase Velocity, decrease Lifetime"},
    {"keywords": ["느리게", "slower"], "change": "decrease Velocity, increase Lifetime and Drag"},
    {"keywords": ["많이", "more"], "change": "increase SpawnRate or SpawnCount"},
    {"keywords": ["적게", "fewer"], "change": "decrease SpawnRate or SpawnCount"},
    {"keywords": ["크게", "bigger"], "change": "increase SpriteSize or Scale"},
    {"keywords": ["작게", "smaller"], "change": "decrease SpriteSize or Scale"},
    {"keywords": ["강하게", "stronger"], "change": "increase force values such as Gravity"},
    {"keywords": ["약하게", "weaker"], "change": "decrease force values"}
  ],
  "guide_notes": [
    "Decide the visible form, emission, motion, and orientation from the request first. Effect names are hints only; one name (e.g. water) can be a fountain, a surface, a stream, or a splash.",
    "If the form is unclear and it changes the build, ask one short question.",
    "search_vfx_recipe first for a saved effect that matches. Otherwise get_vfx_template_guide with form/motion and the effect text for candidates.",
    "Resolve a template path by finding list_name in list_niagara_templates output; never type a template path from memory.",
    "When the user is satisfied (좋아, 완벽, save, perfect), offer save_vfx_recipe."
  ]
}
