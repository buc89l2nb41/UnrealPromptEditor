# copy .env.example .env  (.env is git-ignored; never commit real keys)

# Cursor API key: https://cursor.com/dashboard/integrations
CURSOR_API_KEY=

# Fallback model when the panel sends none, or when the chosen model cannot make an image.
# CURSOR_AI_MODEL=composer-2.5

# Local TRELLIS (StableProjectorz API). Address of the running server:
TRELLIS_URL=http://127.0.0.1:7960
# Optional: TRELLIS install folder. Lets sidecar\start-trellis.bat start it on TRELLIS_URL's port.
TRELLIS_HOME=D:\TRELLIS2-stableprojectorz
